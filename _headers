# Every file: the browser keeps to https for a year and never guesses a file's type, and a link out says only which site
# it came from. Below it, no other site may show a page in a frame (clickjacking) except the home page. The site frames
# nothing of its own; the YouTube players it shows are frames of YouTube's pages, which these rules do not touch.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# The framing headers go on every address but the home page (the owner's word, 24 Nov 2026: other sites may show the
# home page in a frame). "/:p" and "/:p/*" match anything below the root and never "/" itself — taking the headers off
# "/" with "! X-Frame-Options" worked in wrangler dev but not on the live site. Inside another site's frame the page
# keeps the owner's powers off (FRAMED_OUT in index.html).
/:p
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
/:p/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

# The page itself must never be served from a stale copy: the service worker is
# network-first for exactly this reason, and a CDN cache would undo that.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# Asked for again every minute or two; a cached copy would defeat the point.
/data/live-now.json
  Cache-Control: no-store
/data/iam-live.json
  Cache-Control: no-store

# Subscribed calendars should notice an edit within the hour.
/*.ics
  Cache-Control: public, max-age=1800

# Which build of the page is live: asked for on every visit, a few bytes (see sw.js).
/version.txt
  Cache-Control: no-store
# Pictures and fonts never change under a name (a replaced one gets a new file name, see CLAUDE.md), so a browser may keep
# them a week without asking again: about 80 fewer requests each time the home page opens. A week, not for ever, so a file
# replaced in place by mistake still heals itself.
/photos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/posters/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/gallery/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/bg/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/covers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/setlists/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/streaming/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
